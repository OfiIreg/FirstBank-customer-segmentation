# Dockerfile.dashboard - serves the Streamlit stakeholder dashboard
# Note: app.py and its data files sit at the repo root (matching the
# actual Streamlit Community Cloud deployment), not in a dashboard/
# subfolder, so this Dockerfile mirrors that same layout.
FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app.py .
COPY model_bundle.joblib .
COPY fairness_results.json .
COPY model_results.json .
COPY shap_feature_importance.csv .
COPY example_predictions.csv .
COPY sample_customers.csv .
RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=10s CMD curl -f http://localhost:8501/_stcore/health || exit 1
CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501"]
